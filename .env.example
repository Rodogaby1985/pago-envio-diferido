# ===================================================
# pago-envio-diferido - Variables de entorno
# Copiar a .env y completar con valores reales
# ===================================================

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pago_envio
DB_USER=postgres
DB_PASSWORD=postgres
# Solo para exponer el puerto de postgres en docker-compose (opcional)
DB_EXPOSE_PORT=5432

# Tiendanube App
# Obtener en https://partners.tiendanube.com
TIENDANUBE_APP_ID=your_tiendanube_app_id
TIENDANUBE_APP_SECRET=your_tiendanube_app_secret
# Secreto para validar firma de webhooks de Tiendanube (opcional)
TIENDANUBE_WEBHOOK_SECRET=your_tiendanube_webhook_secret

# NAVE - Pasarela de pago
# Obtener credenciales en https://nave.com (o plataforma que corresponda)
NAVE_API_KEY=your_nave_api_key
NAVE_API_SECRET=your_nave_api_secret
NAVE_WEBHOOK_SECRET=your_nave_webhook_secret
# URL base de la API de NAVE (ajustar según entorno)
NAVE_BASE_URL=https://api.nave.com
# Modo: sandbox (pruebas) o production
NAVE_MODE=sandbox

# URLs de la aplicación
# URL pública donde está alojado el servidor (para webhooks y links)
APP_BASE_URL=http://localhost:3000
# Redirecciones post-pago
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_FAILURE_URL=http://localhost:3000/payment/failure
